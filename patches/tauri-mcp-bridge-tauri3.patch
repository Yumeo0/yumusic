+
+// Tauri 3 exposes a type-erased native handle; this bridge runs on wry.
+pub(crate) fn with_webview<R: Runtime>(
+    window: &WebviewWindow<R>,
+    callback: impl FnOnce(&tauri_runtime_wry::Webview) + Send + 'static,
+) -> tauri::Result<()> {
+    window.with_webview(move |handle| {
+        if let Some(webview) = handle.downcast_ref::<tauri_runtime_wry::Webview>() {
+            callback(webview);
+        }
+    })
+}
