{
	"name": "yumusic",
	"productName": "YuMusic",
	"private": true,
	"version": "0.10.3",
	"description": "Crossplatform app for YTM",
	"license": "GPL-3.0-only",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": ">=1.4.4"
	},
	"scripts": {
		"postinstall": "bun scripts/prepare-mcp.ts",
		"setup:mcp": "bun scripts/prepare-mcp.ts",
		"dev": "bun ./node_modules/vite/bin/vite.js",
		"dev:guest": "bun scripts/dev-guest.ts",
		"release": "bun scripts/release.ts",
		"release:notes": "bun scripts/changelog.ts",
		"build": "bun ./node_modules/typescript/bin/tsc --noEmit && bun ./node_modules/vite/bin/vite.js build",
		"sources:flatpak": "bun scripts/flatpak-sources.ts",
		"check:flatpak-sources": "bun scripts/flatpak-sources.ts --check",
		"build:flatpak": "bun scripts/flatpak.ts build",
		"install:flatpak": "bun scripts/flatpak.ts install",
		"validate:flatpak": "bun scripts/flatpak.ts validate",
		"preview": "bun ./node_modules/vite/bin/vite.js preview",
		"tauri": "bun scripts/tauri.ts",
		"lint": "bun ./node_modules/@biomejs/biome/bin/biome check .",
		"test": "bun test",
		"build:android": "bun run tauri android build --apk"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@bufbuild/protobuf": "^2.16.0",
		"@supabase/supabase-js": "2.118.0",
		"@tanstack/react-virtual": "^3.14.24",
		"@tauri-apps/api": "3.0.0-alpha.3",
		"@tauri-apps/plugin-opener": "3.0.0-alpha.3",
		"@tauri-apps/plugin-os": "3.0.0-alpha.3",
		"@tauri-apps/plugin-process": "3.0.0-alpha.3",
		"@tauri-apps/plugin-updater": "3.0.0-alpha.3",
		"bgutils-js": "^4.0.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"googlevideo": "5.0.1",
		"lucide-react": "^1.65.0",
		"lyric-romanizer": "^0.3.1",
		"parse5": "^8.0.1",
		"peerjs": "^1.5.5",
		"qr-scanner": "^1.4.2",
		"qrcode": "^1.5.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5",
		"tailwind-merge": "^3.7.0",
		"tw-animate-css": "^1.4.0",
		"youtubei.js": "18.3.0"
	},
	"patchedDependencies": {
		"youtubei.js@18.3.0": "patches/youtubei.js@18.3.0.patch",
		"googlevideo@5.0.1": "patches/googlevideo@5.0.1.patch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "3.0.0-alpha.5",
		"@types/bun": "^1.4.4",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"pngjs": "^7.0.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.3.5"
	}
}
