{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"noImplicitAny": true,
		"noEmit": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun"],

		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src", "scripts", "vite.config.ts"]
}
